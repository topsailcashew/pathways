rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper function to check if user owns a resource
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Members collection
    match /members/{memberId} {
      // Anyone authenticated can read members
      allow read: if isAuthenticated();
      // Only authenticated users can create/update/delete members
      allow create, update, delete: if isAuthenticated();
    }

    // Tasks collection
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Communications collection
    match /communications/{commId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Events collection
    match /events/{eventId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Groups collection
    match /groups/{groupId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Workflows collection
    match /workflows/{workflowId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // Ministries collection
    match /ministries/{ministryId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAuthenticated();
    }

    // User profiles collection
    match /users/{userId} {
      // Users can read their own profile
      allow read: if isOwner(userId);
      // Users can create/update their own profile
      allow create, update: if isOwner(userId);
      // Only the user can delete their own profile
      allow delete: if isOwner(userId);
    }

    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
